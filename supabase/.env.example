# Secrets for the edge functions. Copy to supabase/.env for `supabase functions serve --env-file supabase/.env` (it is git-ignored), and set the
# same names on the hosted project with `supabase secrets set --env-file supabase/.env`.
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided to deployed functions by Supabase itself: do not set them there.
# For `functions serve` they are filled in by the CLI too.

# The shared join code your friends type once. Any string; matching ignores case and surrounding spaces. Change it if it leaks.
JOIN_CODE=HOOP-CHANGE-ME

# A long random string. The same value goes into Vault as `settle_secret` (see the README), and pg_cron sends it to the settle function.
#   openssl rand -hex 32
SETTLE_SECRET=change-me-to-a-long-random-string

# Salt for hashing callers' IP addresses in the join rate limit (so the table holds no raw IPs). Any random string.
IP_HASH_SALT=change-me-too
