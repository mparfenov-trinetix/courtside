{
  "expo": {
    "name": "Courtside",
    "slug": "courtside",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "courtside",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D1B2E",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mykolaparfenov.courtside",
      "appleTeamId": "5K6PXTLH38",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mykolaparfenov.courtside",
      "adaptiveIcon": {
        "backgroundColor": "#0D1B2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1B2E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.mykolaparfenov.courtside",
          "widgets": [
            {
              "name": "NextGameWidget",
              "displayName": "Next game",
              "description": "Your team's next fixture",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "./src/widgets/next-game-widget.tsx"
              }
            },
            {
              "name": "TeamFormWidget",
              "displayName": "Team form",
              "description": "Your team's last five results, record and streak",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "./src/widgets/team-form-widget.tsx"
              }
            },
            {
              "name": "FixturesWidget",
              "displayName": "Upcoming games",
              "description": "Your team's next fixtures",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "./src/widgets/fixtures-widget.tsx"
              }
            }
          ],
          "frequentUpdates": true
        }
      ],
      "./plugins/with-pods-deployment-target"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
