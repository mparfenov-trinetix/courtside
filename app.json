{
  "expo": {
    "name": "Courtside",
    "slug": "courtside",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "courtside",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D1B2E",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mykolaparfenov.courtside",
      "appleTeamId": "5K6PXTLH38",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mykolaparfenov.courtside",
      "adaptiveIcon": {
        "backgroundColor": "#0D1B2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1B2E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.mykolaparfenov.courtside",
          "widgets": [
            {
              "name": "NextGameWidget",
              "displayName": "Next game",
              "description": "Your team's next fixture",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "./src/widgets/NextGameWidget/NextGameWidget.tsx"
              }
            },
            {
              "name": "TeamFormWidget",
              "displayName": "Team form",
              "description": "Your team's last five results, record and streak",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "./src/widgets/TeamFormWidget/TeamFormWidget.tsx"
              }
            },
            {
              "name": "FixturesWidget",
              "displayName": "Upcoming games",
              "description": "Your team's next fixtures",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "./src/widgets/FixturesWidget/FixturesWidget.tsx"
              }
            },
            {
              "name": "LockScreenWidget",
              "displayName": "Lock Screen",
              "description": "Your team's record, form and next game on the Lock Screen",
              "ios": {
                "supportedFamilies": [
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "./src/widgets/LockScreenWidget/LockScreenWidget.tsx"
              }
            },
            {
              "name": "WatchlistWidget",
              "displayName": "Watchlist",
              "description": "Scores of the games you starred and the latest lines of your starred players",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "./src/widgets/WatchlistWidget/WatchlistWidget.tsx"
              }
            }
          ],
          "frequentUpdates": true
        }
      ],
      "./plugins/with-pods-deployment-target",
      "expo-video",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
